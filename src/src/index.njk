---
layout: base.njk
permalink: /
title: "Whitetail Painting Solutions — Interior & Exterior Painting in Juniata County, PA"
description: "Interior and exterior painting in Juniata County and Central Pennsylvania. Free estimates and a written price before we start."
---
{% from "parts.njk" import faq, reviews as reviewBlock, finale, gallery, steps as stepBlocks %}
{%- set p = pages.home -%}

  <section id="hero">
    <div class="shell hero-in">
      <div class="hero-copy">
        <div class="flank"><span>{{ p.heroEyebrow }}</span></div>
        {#- Each sentence of the headline starts on its own line. #}
        <h1 class="d">{%- for line in p.heroHeading.split(". ") %}<span class="hl">{{ line }}{% if not loop.last %}.{% endif %}</span> {% endfor -%}</h1>
        <p class="lede">{{ p.heroLede }}</p>
        <div class="hero-acts">
          <a class="btn" href="/contact/">Get a free estimate</a>
          <a class="tel" href="tel:{{ site.phoneLink }}">{{ site.phone }}</a>
        </div>
        <p class="hero-note">Interior &middot; Exterior &middot; Decks &amp; fences</p>
      </div>
      {% photo p.heroPhoto, "A finished room", "ph-tall", "Photo — your best finished room. Wide shot, daylight, nothing on the floor." %}
    </div>
  </section>

  <section class="band band-cream on-cream" id="services">
    <div class="shell">
      <div class="hang">
        <div>
          <div class="eyebrow">What we paint</div>
          <h2 class="d">{{ p.servicesHeading }}</h2>
        </div>
        <div><p class="lede soft">{{ p.servicesLede }}</p></div>
      </div>
      <div class="svc svc-3">
        {#- Cabinets is hidden for now. To bring it back, add "cabinets" to this list,
            remove svc-3 above, and add it back to the nav in _includes/base.njk. #}
        {%- for k in ["interior","exterior","decks"] %}
        {%- set s = pages[k] %}
        <a class="card" href="/{{ k }}/">
          {% photo s.photo, s.category, "ph-sq", "Photo — " + s.photoHint %}
          <div class="card-body">
            <h3 class="d">{{ s.category }}</h3>
            <p>{{ s.lede }}</p>
            <div class="more">See more &rarr;</div>
          </div>
        </a>
        {%- endfor %}
      </div>
    </div>
  </section>

  {#- Only jobs that have BOTH a before and an after photo are shown. One for now.
      When there are more, change limit(1) to limit(3) and put the
      "See more of our work" link back under the gallery. #}
  {%- set shown = projects.items | selectattr("before") | selectattr("after") | newestFirst | limit(1) %}
  {%- if shown.length %}
  <section class="band">
    <div class="shell">
      <div class="ba-head">
        <div class="flank"><span>Our work</span></div>
        <h2 class="d">Before &amp; after.</h2>
      </div>
      {{ gallery(shown, true, site) }}
    </div>
  </section>
  {%- endif %}

  <section class="band band-sand on-cream" id="process">
    <div class="shell">
      <div class="hang">
        <div>
          <div class="flank"><span>How it goes</span></div>
          <h2 class="d">Here's how it works.</h2>
        </div>
        <div>
          <p class="lede soft">Four simple steps, from your first call to fresh paint.</p>
        </div>
      </div>
      {{ stepBlocks([
        { title: "Tell us about it",
          body: "Call us or fill out the form. Photos help a lot." },
        { title: "We come look",
          body: "We stop by, look at the job, and answer your questions. It's free." },
        { title: "You get a price",
          body: "We give you the price in writing. Nothing starts until you say yes." },
        { title: "We paint",
          body: "We cover your floors and furniture, then get to work." }
      ]) }}
      <p style="margin-top:48px"><a class="btn btn-dark" href="/contact/">Get a free estimate</a></p>
    </div>
  </section>

  <section class="band band-cream on-cream">
    <div class="shell split">
      {% photo p.aboutPhoto, "The crew", "ph-tall", "Photo — the crew, or the owner on a job site. A real one beats a stock one." %}
      <div>
        <div class="eyebrow">About us</div>
        <h2 class="d">{{ p.aboutHeading }}</h2>
        <p class="lede" style="margin-top:24px">{{ p.aboutLine }}</p>
        <p class="soft" style="margin-top:18px">{{ p.aboutBody }}</p>
        <ul class="pts">
          {%- for x in p.aboutPoints %}
          <li>{{ x }}</li>
          {%- endfor %}
        </ul>
        <p style="margin-top:28px"><a class="textlink" href="/about/">More about us &rarr;</a></p>
      </div>
    </div>
  </section>

{{ reviewBlock(reviews) }}

{%- if collections.posts.length %}
  <section class="band">
    <div class="shell">
      <div class="hang">
        <div>
          <div class="eyebrow">{{ pages.blog.eyebrow }}</div>
          <h2 class="d">{{ pages.blog.heading }}</h2>
        </div>
        <div><p class="lede soft">{{ pages.blog.lede }}</p></div>
      </div>
      <div class="svc svc-3">
        {%- for post in collections.posts | limit(3) %}
        <a class="card" href="{{ post.url }}">
          {% photo post.data.cover, post.data.title, "ph-sq", "Photo — add a cover image" %}
          <div class="card-body">
            <div class="gcap" style="margin:0 0 10px">{{ post.date | readableDate }}</div>
            <h3 class="d">{{ post.data.title }}</h3>
            <p>{{ post.data.summary }}</p>
            <div class="more">Read it &rarr;</div>
          </div>
        </a>
        {%- endfor %}
      </div>
      <p style="margin-top:36px"><a class="textlink" href="/notes/">All notes &rarr;</a></p>
    </div>
  </section>
{%- endif %}

{{ faq(p.faq) }}
{{ finale(site, "Let's talk about your project.",
   "It only takes two minutes. We'll call you back and set up a time to come look.") }}
