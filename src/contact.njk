---
layout: base.njk
permalink: /contact/
title: "Free Estimate — Whitetail Painting Solutions, Juniata County PA"
description: "Request a free painting estimate from Whitetail Painting Solutions in Juniata County, Pennsylvania. Takes about two minutes, and there is no charge."
---
{% from "parts.njk" import phero, faq %}
{%- set p = pages.contact -%}
{{ phero("Free Estimate", p.eyebrow, p.heading, p.lede, false) }}

  <section class="band band-2">
    <div class="shell hang">
      <div>
        <div class="eyebrow">Get in touch</div>
        <h2 class="d">Would rather talk?</h2>
        <p class="lede soft" style="margin-top:22px">Call or text. If we are up a ladder we will
          get back to you the same day.</p>
        <p style="margin-top:20px"><a class="tel" href="tel:{{ site.phoneLink }}">{{ site.phone }}</a></p>

        <h3 class="d" style="margin-top:44px">{{ p.helpsHeading }}</h3>
        <ul class="pts">
          {%- for x in p.helps %}
          <li>{{ x }}</li>
          {%- endfor %}
        </ul>
        <p class="soft" style="margin-top:26px;font-size:15px">None of it is required. If you only
          know that you want the house painted, that is enough to start.</p>
      </div>

      <div class="formwrap">
        {# Field names are deliberately plain and close to what a CRM expects
           on import. Renaming one means changing whatever receives it too —
           see assets/site.js. #}
        <form id="estimateForm" novalidate>
          <div class="fgrid">
            <div class="f">
              <label for="first_name">First name</label>
              <input id="first_name" name="first_name" type="text" autocomplete="given-name">
            </div>
            <div class="f">
              <label for="last_name">Last name</label>
              <input id="last_name" name="last_name" type="text" autocomplete="family-name">
            </div>
            <div class="f">
              <label for="phone">Phone</label>
              <input id="phone" name="phone" type="tel" autocomplete="tel">
            </div>
            <div class="f">
              <label for="email">Email</label>
              <input id="email" name="email" type="email" autocomplete="email">
            </div>
            <div class="f wide">
              <label for="address">Where is the job?</label>
              <input id="address" name="address" type="text" autocomplete="street-address">
            </div>
            <div class="f">
              <label for="job_type">What needs painting?</label>
              <select id="job_type" name="job_type">
                <option value="">Choose one</option>
                <option>Interior</option>
                <option>Exterior</option>
                <option>Cabinets</option>
                <option>Deck or fence</option>
                <option>More than one</option>
                <option>Not sure yet</option>
              </select>
            </div>
            <div class="f">
              <label for="timing">When were you hoping?</label>
              <select id="timing" name="timing">
                <option value="">Choose one</option>
                <option>As soon as you can</option>
                <option>In the next month</option>
                <option>In the next few months</option>
                <option>Just getting a price for now</option>
              </select>
            </div>
            <div class="f wide">
              <label for="notes">Anything else we should know?</label>
              <textarea id="notes" name="notes"></textarea>
            </div>
          </div>
          <p style="margin-top:28px">
            <button class="btn" type="submit" id="sendBtn">Send it over</button>
          </p>
          <p class="fnote">We will use this to get back to you about your painting job, and
            nothing else. No list, no sharing it around.</p>
          <p class="fmsg" id="formMsg" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>

{{ faq(p.faq, "Questions", "Before you send it.") }}
