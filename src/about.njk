---
layout: base.njk
permalink: /about/
title: "About Us — Whitetail Painting Solutions, Juniata County PA"
description: "Meet Nick Sheaffer, owner of Whitetail Painting Solutions in Juniata County, Pennsylvania. He has been painting since he was 12."
---
{% from "parts.njk" import phero, reviews as reviewBlock, finale %}
{%- set p = pages.about -%}
{{ phero("About", p.eyebrow, p.heading, p.lede) }}

  <section class="band band-2">
    <div class="shell split">
      {% photo p.photo, "The crew", "ph-tall", "Photo — the crew, or the owner on a job site. A real one beats a stock one." %}
      <div>
        <div class="eyebrow">Who we are</div>
        <h2 class="d">{{ p.whoHeading }}</h2>
        {%- for para in p.whoBody | paragraphs %}
        <p class="{% if loop.first %}lede {% endif %}soft"{% if loop.first %} style="margin-top:22px"{% endif %}>{{ para }}</p>
        {%- endfor %}
      </div>
    </div>
  </section>

  {#- The one promise we lead with. Big, centered, a few words. #}
  <section class="band band-cream on-cream feature">
    <div class="shell">
      <div class="flank"><span>How we work</span></div>
      <h2 class="d">Your house, not a job site.</h2>
      <p class="lede soft">We cover your floors, protect your things, and treat your home like
        it's our own. You should be able to live there while we work.</p>
      <p style="margin-top:34px"><a class="btn btn-dark" href="/contact/">Get a free estimate</a></p>
    </div>
  </section>

  <section class="band">
    <div class="shell hang">
      <div>
        <div class="eyebrow">Where we work</div>
        <h2 class="d">Juniata County and nearby.</h2>
      </div>
      <div>
        <p class="lede soft">We work in {{ site.areaLong }}, about an hour from home.
          If you're a little farther, ask anyway. We may already be working near you.</p>
        <ul class="pts">
          {%- for t in site.areaTowns %}
          <li>{{ t }}</li>
          {%- endfor %}
        </ul>
      </div>
    </div>
  </section>

  <section class="band band-2">
    <div class="shell{% if p.truckPhoto %} split-r{% endif %}">
      <div>
        <div class="eyebrow">Paperwork</div>
        <h2 class="d">Yes, we're insured.</h2>
        <p class="lede soft" style="margin-top:22px">{{ site.insuredLine }}</p>
        <p style="margin-top:26px"><a class="textlink" href="/contact/">Ask us anything &rarr;</a></p>
      </div>
      {%- if p.truckPhoto %}
      {% photo p.truckPhoto, "The truck", "ph-wide", "Photo — the truck, or the crew at work" %}
      {%- endif %}
    </div>
  </section>

{{ reviewBlock(reviews) }}
{{ finale(site, "Come see what we do.",
   "Tell us about your house and we'll come take a look. It's free.") }}
